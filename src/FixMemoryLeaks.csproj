<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AssemblyName>FixMemoryLeaks</AssemblyName>
        <RootNamespace>FixMemoryLeaks</RootNamespace>
        <GamePath>C:\Program Files (x86)\Steam\steamapps\common\Rain World</GamePath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp"><HintPath>$(GamePath)\RainWorld_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(GamePath)\RainWorld_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine"><HintPath>$(GamePath)\RainWorld_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)\RainWorld_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="BepInEx"><HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(GamePath)\BepInEx\core\MonoMod.RuntimeDetour.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="MonoMod.Utils"><HintPath>$(GamePath)\BepInEx\core\MonoMod.Utils.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="HOOKS-Assembly-CSharp"><HintPath>$(GamePath)\BepInEx\plugins\HOOKS-Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    </ItemGroup>

    <Target Name="CopyToMod" AfterTargets="PostBuildEvent">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)../mod/plugins/" />
    </Target>

</Project>
